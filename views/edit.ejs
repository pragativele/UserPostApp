<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="w-full flex justify-end">
            <a class="mb-5 inline-block bg-red-500 rounded-md px-3 py-2 text-sm" href="/logout">LogOut</a>
        </div>
        <h5 class="mb-5">edit your post</h5>
        <form method="post" action ="/update/<%= post._id %>">
            <textarea placeholder="What's on your mind" name="content" class="p-3 outline-none w-1/3 block resize-none bg-transparent border-2 border-zinc-800 rounded-md"><%= post.content%></textarea>
            <input class="px-3 py-2 text-black bg-yellow-500 block rounded-md mt-2 w-40 text-sm" type="submit" value="Update post">
        </form>
    </div>
</body>
</html>